# ============================================================
# Student Life OS — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----- Django Core -----
SECRET_KEY=your-very-long-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Database -----
DATABASE_URL=postgresql://slos_user:slos_pass@localhost:5432/student_life_os
DB_NAME=student_life_os
DB_USER=slos_user
DB_PASSWORD=slos_pass
DB_HOST=localhost
DB_PORT=5432

# ----- Redis (Cache + Celery) -----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- JWT Auth -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@studentlifeos.app

# ----- Field Encryption (Journal / Finance) -----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# ----- AI Assistant (optional — leave blank to disable) -----
LLM_PROVIDER=disabled
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# ----- Frontend (Vite) -----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Student Life OS
