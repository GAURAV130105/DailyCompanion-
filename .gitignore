backend/lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.pot
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
.venv/
venv/
ENV/

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.local

