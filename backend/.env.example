# Student Life OS Backend Environment Variables
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-django-insecure-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DB_NAME=student_life_os
DB_USER=slos_user
DB_PASSWORD=slos_pass
DB_HOST=localhost
DB_PORT=5432
# Set DATABASE_URL if preferred:
# DATABASE_URL=postgresql://slos_user:slos_pass@localhost:5432/student_life_os

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@studentlifeos.app

# Security & Encryption Key (Fernet 32 url-safe base64-encoded bytes)
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS0zMi1ieXRlLWtleS0xMjM0NTY=

# AI Assistant
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=gpt-4o
